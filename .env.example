# --- Bolna (voice) --------------------------------------------------------
# API key from https://platform.bolna.ai (Developers -> API keys)
BOLNA_API_KEY=
# Printed by `python scripts/create_agent.py`
BOLNA_AGENT_ID=

# Public https URL of the deployed backend (e.g. https://voicesite.onrender.com).
# Bolna calls its /tools/* endpoints during a voice call.
PUBLIC_BASE_URL=
# Any random string. Bolna sends it as "Authorization: Bearer <secret>".
TOOL_SECRET=

# Seconds a voice tool call waits for an edit before saying "working on it"
TOOL_SYNC_WAIT=8

# --- LLM that writes the website (set ONE key) ------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: better stock photos for the researcher (free key: https://www.pexels.com/api/).
# Without it, photos come from Wikimedia Commons.
PEXELS_API_KEY=

# Optional: force a provider (anthropic | openai | gemini | groq) or override tier models
# LLM_PROVIDER=
# MODEL_JNR=
# MODEL_SNR=
# MODEL_ARCHITECT=

# --- Accounts (optional) ----------------------------------------------------
# Signs session cookies and encrypts stored GitHub tokens / user API keys.
# If unset, a random one is generated and kept in data/.session_secret.
SESSION_SECRET=
# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client (Web)
#   Authorized redirect URI: <your site>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers > New OAuth App
#   Authorization callback URL: <your site>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
